MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/itsm_chatbot
JWT_PRIVATE_KEY=<base64-encoded-rsa-private-key>
JWT_PUBLIC_KEY=<base64-encoded-rsa-public-key>
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=<base64-encoded-32-byte-key>
LITELLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ALLOWED_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://redis:6379/0
AI_WRITE_OPERATIONS=false
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=10
MAX_INPUT_CHARS=4000
CONVERSATION_CONTEXT_TURNS=6
